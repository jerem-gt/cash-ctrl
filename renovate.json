{
  "extends": ["config:recommended", "group:allNonMajor", "group:react"],
  "baseBranchPatterns": ["develop"],
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"],
    "automerge": false
  },
  "packageRules": [
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
