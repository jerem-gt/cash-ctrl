PORT=3000
DATA_DIR=./data
SESSION_SECRET=dev-secret-not-for-production
NODE_ENV=development

# Facultatif : URL publique de l'application (sans slash final), utilisée pour les liens des e-mails
# APP_URL=https://cash.example.com

# Facultatif : envoi d'e-mails (mot de passe oublié). Sans SMTP, le lien est écrit dans les logs.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=cashctrl@example.com
# SMTP_PASS=
# SMTP_FROM=cashctrl@example.com
